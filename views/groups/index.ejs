<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="flex-1 flex overflow-hidden">
  <%- include('../partials/sidebar') %>

  <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 bg-slate-50/50">
    <div class="max-w-7xl mx-auto space-y-6">
      
      <div>
        <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Data Kelompok Tani Binaan</h1>
        <p class="text-xs text-slate-500 mt-1">Daftar kelompok tani Orang Asli Papua (OAP) di 10 distrik Kabupaten Biak Numfor.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% groups.forEach(g => { %>
        <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6 flex flex-col justify-between hover:shadow-md transition">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="font-mono text-xs font-bold text-slate-400 bg-slate-100 px-2 py-0.5 rounded-md"><%= g.kode_kelompok %></span>
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 uppercase"><%= g.status_keaktifan %></span>
            </div>

            <h3 class="font-extrabold text-slate-900 text-base mb-1"><%= g.nama_kelompok %></h3>
            <p class="text-xs text-emerald-700 font-bold mb-4">Komoditas: <%= g.komoditas_utama %></p>

            <div class="space-y-2 text-xs border-t border-slate-100 pt-3">
              <div class="flex justify-between">
                <span class="text-slate-400">Ketua Kelompok:</span>
                <span class="font-semibold text-slate-700"><%= g.nama_ketua %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-slate-400">Wilayah:</span>
                <span class="font-semibold text-slate-700"><%= g.kampung %>, <%= g.distrik %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-slate-400">Anggota Terdaftar:</span>
                <span class="font-bold text-brand-800"><%= g.anggota_terdaftar %> Petani</span>
              </div>
              <div class="flex justify-between">
                <span class="text-slate-400">Kontak:</span>
                <span class="font-mono text-slate-600"><%= g.kontak_ketua || '-' %></span>
              </div>
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
            <a href="/groups/<%= g.id %>" class="text-xs font-bold text-brand-700 hover:text-brand-800 flex items-center space-x-1">
              <span>Lihat Anggota & Kebun</span>
              <i class="bi bi-arrow-right"></i>
            </a>
          </div>
        </div>
        <% }) %>
      </div>

    </div>
  </main>
</div>

<%- include('../partials/footer') %>
