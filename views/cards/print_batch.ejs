<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="flex-1 flex overflow-hidden">
  <%- include('../partials/sidebar') %>

  <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 bg-slate-50/50">
    <div class="max-w-7xl mx-auto space-y-6">
      
      <!-- Filter Toolbar -->
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 no-print">
        <div>
          <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Cetak Lembar Kartu Tani OAP</h1>
          <p class="text-xs text-slate-500 mt-1">Cetak kartu massal untuk petani yang telah berstatus Ditetapkan (Aktif).</p>
        </div>
        <div class="flex items-center space-x-3">
          <form action="/cards/print-batch" method="GET" class="flex items-center space-x-2">
            <select name="distrik" class="px-3 py-2 text-xs bg-white border border-slate-200 rounded-xl focus:ring-2 focus:ring-brand-500 outline-none">
              <option value="all">Semua Distrik</option>
              <% districts.forEach(d => { %>
                <option value="<%= d.nama_distrik %>" <%= selectedDistrik === d.nama_distrik ? 'selected' : '' %>>
                  <%= d.nama_distrik %>
                </option>
              <% }) %>
            </select>
            <select name="limit" class="px-3 py-2 text-xs bg-white border border-slate-200 rounded-xl focus:ring-2 focus:ring-brand-500 outline-none">
              <option value="6" <%= limit == 6 ? 'selected' : '' %>>6 Kartu</option>
              <option value="12" <%= limit == 12 ? 'selected' : '' %>>12 Kartu</option>
              <option value="24" <%= limit == 24 ? 'selected' : '' %>>24 Kartu</option>
            </select>
            <button type="submit" class="px-3 py-2 rounded-xl bg-slate-700 text-white font-bold text-xs hover:bg-slate-600 transition">
              Tampilkan
            </button>
          </form>
          <button onclick="window.print()" class="px-5 py-2 rounded-xl bg-brand-700 hover:bg-brand-600 text-white font-bold text-xs shadow-md shadow-brand-700/20 transition flex items-center space-x-1.5">
            <i class="bi bi-printer-fill"></i>
            <span>Cetak Lembar (Print)</span>
          </button>
        </div>
      </div>

      <!-- Printable Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-6 print:grid-cols-2 print:gap-4">
        <% farmers.forEach(f => { %>
        <div class="rounded-3xl p-5 shadow-lg relative overflow-hidden text-white"
             style="background: linear-gradient(135deg, #022c22 0%, #064e3b 50%, #065f46 100%); border: 2.5px solid #d97706; page-break-inside: avoid;">
          
          <!-- Header -->
          <div class="flex items-center space-x-2.5 border-b border-emerald-600/40 pb-2.5 mb-3">
            <div class="w-9 h-9 rounded-xl bg-amber-500 flex items-center justify-center text-brand-950 font-extrabold text-lg">
              <i class="bi bi-flower1"></i>
            </div>
            <div>
              <div class="text-[9px] font-bold text-amber-400 uppercase leading-none">DINAS PERTANIAN BIAK NUMFOR</div>
              <div class="text-xs font-extrabold tracking-tight text-white mt-0.5">KARTU TANI OAP (PAPUA)</div>
            </div>
          </div>

          <!-- Body -->
          <div class="grid grid-cols-12 gap-3 items-center">
            <div class="col-span-3 flex flex-col items-center">
              <div class="w-16 h-20 rounded-xl bg-slate-200 border-2 border-amber-400 overflow-hidden shadow">
                <img src="/img/default-avatar.png" alt="Foto" class="w-full h-full object-cover">
              </div>
              <span class="mt-1 px-1.5 py-0.2 rounded-full text-[8px] font-extrabold bg-emerald-400 text-brand-950">
                AKTIF
              </span>
            </div>

            <div class="col-span-6 space-y-0.5 text-[11px]">
              <div>
                <span class="text-[8px] text-emerald-300 block">Nomor Kartu:</span>
                <span class="font-mono font-bold text-amber-300 text-xs"><%= f.nomor_kartu %></span>
              </div>
              <div>
                <span class="text-[8px] text-emerald-300 block">Nama:</span>
                <span class="font-extrabold text-white"><%= f.nama_lengkap %></span>
              </div>
              <div>
                <span class="text-[8px] text-emerald-300 block">Distrik/Kampung:</span>
                <span class="text-slate-200 text-[10px]"><%= f.distrik %> / <%= f.kampung %></span>
              </div>
              <div>
                <span class="text-[8px] text-emerald-300 block">Komoditas:</span>
                <span class="font-semibold text-amber-300 text-[10px]"><%= f.komoditas_utama %></span>
              </div>
            </div>

            <div class="col-span-3 flex flex-col items-center justify-center p-1.5 rounded-xl bg-white shadow-inner">
              <img src="<%= f.qrDataUrl %>" alt="QR" class="w-16 h-16 rounded object-contain">
              <span class="text-[7px] font-mono font-bold text-slate-800 mt-0.5">SCAN DAMRI</span>
            </div>
          </div>

          <!-- Footer -->
          <div class="mt-3 pt-2 border-t border-emerald-600/30 flex items-center justify-between text-[8px] text-emerald-200/80">
            <span>NIK: <%= f.nik %></span>
            <span>Program Otsus Papua 2026</span>
          </div>

        </div>
        <% }) %>
      </div>

    </div>
  </main>
</div>

<%- include('../partials/footer') %>
