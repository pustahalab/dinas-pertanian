<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="flex-1 flex overflow-hidden">
  <%- include('../partials/sidebar') %>

  <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 bg-slate-50/50">
    <div class="max-w-7xl mx-auto space-y-6">
      
      <!-- Header -->
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-amber-100 text-amber-800 text-xs font-bold mb-1">
            <i class="bi bi-gift-fill"></i>
            <span>Dana Otonomi Khusus (Otsus) Papua</span>
          </div>
          <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Program Bantuan Pertanian Otsus 2026</h1>
          <p class="text-xs text-slate-500 mt-0.5">Pengelolaan program bantuan subsidi transportasi DAMRI, saprodi, bibit unggul, dan alsintan untuk petani OAP.</p>
        </div>
        <div class="flex items-center space-x-2">
          <% if (['admin', 'petugas'].includes(currentUser.role)) { %>
          <a href="/aids/disburse" class="px-4 py-2.5 rounded-xl bg-brand-700 hover:bg-brand-600 text-white text-xs font-bold transition flex items-center space-x-2 shadow-md shadow-brand-700/20">
            <i class="bi bi-box-arrow-up-right"></i>
            <span>Catat Penyaluran Baru</span>
          </a>
          <% } %>
          <a href="/reports/aids" class="px-4 py-2.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-bold transition flex items-center space-x-2">
            <i class="bi bi-file-earmark-text"></i>
            <span>Laporan Realisasi</span>
          </a>
        </div>
      </div>

      <!-- Program Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% programs.forEach(p => { %>
        <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6 flex flex-col justify-between hover:shadow-md transition">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="font-mono text-xs font-bold text-slate-400 bg-slate-100 px-2 py-0.5 rounded-md"><%= p.kode_program %></span>
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 uppercase"><%= p.status %></span>
            </div>
            
            <h3 class="font-extrabold text-slate-900 text-base leading-tight mb-2"><%= p.nama_program %></h3>
            <p class="text-xs text-slate-500 mb-4 line-clamp-3 leading-relaxed"><%= p.deskripsi %></p>

            <div class="space-y-2 text-xs border-t border-slate-100 pt-3">
              <div class="flex justify-between">
                <span class="text-slate-400">Jenis Bantuan:</span>
                <span class="font-semibold text-slate-700"><%= p.jenis_bantuan %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-slate-400">Total Anggaran:</span>
                <span class="font-bold text-amber-700">Rp <%= parseFloat(p.anggaran_total).toLocaleString('id-ID') %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-slate-400">Kuota / Realisasi:</span>
                <span class="font-bold text-brand-800"><%= p.total_tersalurkan %> / <%= p.kuota_penerima %> Petani</span>
              </div>
            </div>

            <!-- Progress Bar -->
            <div class="mt-4">
              <% const pct = Math.min(100, Math.round((p.total_tersalurkan / (p.kuota_penerima || 1)) * 100)); %>
              <div class="flex justify-between text-[10px] font-bold text-slate-400 mb-1">
                <span>Penyaluran</span>
                <span><%= pct %>%</span>
              </div>
              <div class="w-full bg-slate-100 h-2 rounded-full overflow-hidden">
                <div class="bg-brand-600 h-2 rounded-full" style="width: <%= pct %>%;"></div>
              </div>
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
            <a href="/aids/programs/<%= p.id %>" class="text-xs font-bold text-brand-700 hover:text-brand-800 flex items-center space-x-1">
              <span>Detail & Penerima</span>
              <i class="bi bi-arrow-right"></i>
            </a>
            <% if (['admin', 'petugas'].includes(currentUser.role)) { %>
            <a href="/aids/disburse?program_id={{p.id}}" class="px-3 py-1.5 rounded-xl bg-emerald-50 hover:bg-emerald-100 text-brand-900 font-bold text-xs transition">
              + Salurkan
            </a>
            <% } %>
          </div>
        </div>
        <% }) %>
      </div>

      <!-- Recent Disbursements Table -->
      <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="p-6 border-b border-slate-100 flex items-center justify-between">
          <div>
            <h3 class="font-extrabold text-slate-900 text-base">Realisasi Penyaluran Bantuan Terkini</h3>
            <p class="text-xs text-slate-500">Daftar petani penerima manfaat program Otsus tahun anggaran 2026</p>
          </div>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-50 text-slate-400 uppercase font-bold text-[10px] tracking-wider border-b border-slate-100">
              <tr>
                <th class="py-3 px-4">Nama Petani</th>
                <th class="py-3 px-4">Program Otsus</th>
                <th class="py-3 px-4">Volume / Item Bantuan</th>
                <th class="py-3 px-4">Wilayah</th>
                <th class="py-3 px-4">Tanggal</th>
                <th class="py-3 px-4 text-center">Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% recentDisbursements.forEach(r => { %>
              <tr class="hover:bg-slate-50/60 transition">
                <td class="py-3.5 px-4">
                  <div class="font-bold text-slate-900"><%= r.nama_petani %></div>
                  <div class="text-[10px] text-slate-400 font-mono"><%= r.nomor_kartu %></div>
                </td>
                <td class="py-3.5 px-4 font-semibold text-slate-700">
                  <%= r.nama_program %>
                </td>
                <td class="py-3.5 px-4 font-bold text-brand-800">
                  <%= r.volume_bantuan %>
                </td>
                <td class="py-3.5 px-4 text-slate-600">
                  <%= r.kampung %>, <%= r.distrik %>
                </td>
                <td class="py-3.5 px-4 text-slate-500 text-[11px]">
                  <%= r.tanggal_penyaluran %>
                </td>
                <td class="py-3.5 px-4 text-center">
                  <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 uppercase">
                    <%= r.status_realisasi %>
                  </span>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </main>
</div>

<%- include('../partials/footer') %>
