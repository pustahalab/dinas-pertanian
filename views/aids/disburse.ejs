<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="flex-1 flex overflow-hidden">
  <%- include('../partials/sidebar') %>

  <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 bg-slate-50/50">
    <div class="max-w-3xl mx-auto space-y-6">
      
      <div>
        <a href="/aids" class="text-xs font-bold text-slate-500 hover:text-brand-800 transition flex items-center space-x-1">
          <i class="bi bi-arrow-left"></i>
          <span>Kembali ke Program Bantuan</span>
        </a>
      </div>

      <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6 sm:p-8">
        <div class="border-b border-slate-100 pb-5 mb-6">
          <h1 class="text-xl font-extrabold text-slate-900">Catat Penyaluran Bantuan Otsus ke Petani</h1>
          <p class="text-xs text-slate-500 mt-1">Rekam realisasi serah terima bantuan bibit, alsintan, atau saprodi pertanian kepada petani OAP.</p>
        </div>

        <form action="/aids/disburse" method="POST" class="space-y-4 text-xs">
          
          <div>
            <label class="block font-bold text-slate-700 mb-1">Pilih Program Bantuan Otsus *</label>
            <select name="program_id" required class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-brand-500 font-semibold text-slate-900">
              <% programs.forEach(p => { %>
                <option value="<%= p.id %>" <%= selectedProgramId == p.id ? 'selected' : '' %>>
                  [<%= p.kode_program %>] <%= p.nama_program %> (<%= p.jenis_bantuan %>)
                </option>
              <% }) %>
            </select>
          </div>

          <div>
            <label class="block font-bold text-slate-700 mb-1">Pilih Petani OAP Penerima *</label>
            <select name="petani_id" required class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-brand-500">
              <% farmers.forEach(f => { %>
                <option value="<%= f.id %>" <%= selectedPetaniId == f.id ? 'selected' : '' %>>
                  <%= f.nama_lengkap %> - <%= f.nomor_kartu %> (Distrik <%= f.distrik %>, <%= f.kampung %>)
                </option>
              <% }) %>
            </select>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block font-bold text-slate-700 mb-1">Volume / Jumlah Barang *</label>
              <input type="text" name="volume_bantuan" required placeholder="Contoh: 50 Kg Bibit Keladi / 2 Sak Pupuk"
                class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-brand-500">
            </div>

            <div>
              <label class="block font-bold text-slate-700 mb-1">Estimasi Nilai Barang (Rp)</label>
              <input type="number" name="nilai_perkiraan" value="500000"
                class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-brand-500">
            </div>

            <div>
              <label class="block font-bold text-slate-700 mb-1">Tanggal Penyaluran *</label>
              <input type="date" name="tanggal_penyaluran" required
                value="<%= new Date().toISOString().slice(0, 10) %>"
                class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-brand-500">
            </div>

            <div>
              <label class="block font-bold text-slate-700 mb-1">Lokasi Penyaluran</label>
              <input type="text" name="lokasi_penyaluran" value="Balai Kampung / Kantor Distrik"
                class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-brand-500">
            </div>
          </div>

          <div>
            <label class="block font-bold text-slate-700 mb-1">Catatan Serah Terima</label>
            <textarea name="catatan" rows="2" placeholder="Catatan kondisi bantuan saat serah terima..."
              class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-brand-500">Bantuan diserahkan dalam kondisi baik dan disaksikan ketua kelompok tani.</textarea>
          </div>

          <div class="pt-4 border-t border-slate-100 flex items-center justify-end space-x-3">
            <a href="/aids" class="px-5 py-2.5 rounded-xl border border-slate-200 text-slate-600 font-bold hover:bg-slate-50 transition">
              Batal
            </a>
            <button type="submit" class="px-6 py-2.5 rounded-xl bg-brand-700 hover:bg-brand-600 text-white font-bold transition shadow-md shadow-brand-700/20">
              Simpan Penyaluran
            </button>
          </div>

        </form>
      </div>

    </div>
  </main>
</div>

<%- include('../partials/footer') %>
