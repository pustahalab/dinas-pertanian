<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="flex-1 flex overflow-hidden">
  <%- include('../partials/sidebar') %>

  <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 bg-slate-50/50">
    <div class="max-w-7xl mx-auto space-y-6">
      
      <!-- Toolbar -->
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 no-print">
        <div>
          <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Laporan Rekapitulasi Data Petani OAP</h1>
          <p class="text-xs text-slate-500 mt-1">Dinas Pertanian dan Ketahanan Pangan Kabupaten Biak Numfor.</p>
        </div>
        <div class="flex items-center space-x-3">
          <form action="/reports/farmers" method="GET" class="flex items-center space-x-2">
            <select name="distrik" class="px-3 py-2 text-xs bg-white border border-slate-200 rounded-xl focus:ring-2 focus:ring-brand-500 outline-none">
              <option value="all">Semua Distrik</option>
              <% districts.forEach(d => { %>
                <option value="<%= d.nama_distrik %>" <%= selectedDistrik === d.nama_distrik ? 'selected' : '' %>><%= d.nama_distrik %></option>
              <% }) %>
            </select>
            <select name="status" class="px-3 py-2 text-xs bg-white border border-slate-200 rounded-xl focus:ring-2 focus:ring-brand-500 outline-none">
              <option value="all">Semua Status</option>
              <option value="ditetapkan" <%= selectedStatus === 'ditetapkan' ? 'selected' : '' %>>Ditetapkan</option>
              <option value="terverifikasi" <%= selectedStatus === 'terverifikasi' ? 'selected' : '' %>>Terverifikasi</option>
              <option value="diajukan" <%= selectedStatus === 'diajukan' ? 'selected' : '' %>>Diajukan</option>
            </select>
            <button type="submit" class="px-3 py-2 rounded-xl bg-slate-700 text-white font-bold text-xs">Filter</button>
          </form>
          <a href="/reports/farmers?distrik=<%= selectedDistrik %>&status=<%= selectedStatus %>&export=csv" class="px-4 py-2 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-bold text-xs transition flex items-center space-x-1.5 shadow-sm">
            <i class="bi bi-file-earmark-spreadsheet text-emerald-600"></i>
            <span>Unduh CSV</span>
          </a>
          <button onclick="window.print()" class="px-4 py-2 rounded-xl bg-brand-700 hover:bg-brand-600 text-white font-bold text-xs transition flex items-center space-x-1.5 shadow-sm">
            <i class="bi bi-printer-fill"></i>
            <span>Cetak Dokumen</span>
          </button>
        </div>
      </div>

      <!-- Official Report Paper Container -->
      <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6 sm:p-10 print:shadow-none print:border-none print:p-0">
        
        <!-- Kop Surat Resmi (Government Letterhead) -->
        <div class="border-b-4 border-double border-slate-800 pb-4 mb-6 text-center">
          <div class="flex items-center justify-center space-x-4 mb-2">
            <div class="w-16 h-16 rounded-full bg-emerald-700 text-white flex items-center justify-center font-extrabold text-3xl">
              <i class="bi bi-shield-fill"></i>
            </div>
            <div>
              <h2 class="text-sm font-bold tracking-widest text-slate-800 uppercase">PEMERINTAH KABUPATEN BIAK NUMFOR</h2>
              <h1 class="text-lg sm:text-xl font-extrabold text-slate-900 uppercase tracking-tight">DINAS PERTANIAN DAN KETAHANAN PANGAN</h1>
              <p class="text-xs text-slate-600">Jalan Majapahit No. 1, Samofa, Kabupaten Biak Numfor, Provinsi Papua 98111</p>
            </div>
          </div>
          <div class="text-[11px] font-bold text-slate-700 uppercase tracking-wider mt-3">
            DAFTAR PENERIMA BANTUAN KARTU TANI ORANG ASLI PAPUA (OAP) TAHUN ANGGARAN 2026
          </div>
          <div class="text-[10px] text-slate-500">
            Sumber Pendanaan: Dana Otonomi Khusus (Otsus) Papua &bull; Filter: Distrik [<%= selectedDistrik.toUpperCase() %>], Status [<%= selectedStatus.toUpperCase() %>]
          </div>
        </div>

        <!-- Table -->
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs border-collapse">
            <thead>
              <tr class="border-y-2 border-slate-800 bg-slate-50 text-[10px] uppercase font-bold text-slate-700">
                <th class="py-2.5 px-3 border border-slate-300 text-center w-10">No</th>
                <th class="py-2.5 px-3 border border-slate-300">Nomor Kartu</th>
                <th class="py-2.5 px-3 border border-slate-300">NIK</th>
                <th class="py-2.5 px-3 border border-slate-300">Nama Petani OAP</th>
                <th class="py-2.5 px-3 border border-slate-300">Distrik & Kampung</th>
                <th class="py-2.5 px-3 border border-slate-300">Kelompok Tani</th>
                <th class="py-2.5 px-3 border border-slate-300">Komoditas</th>
                <th class="py-2.5 px-3 border border-slate-300 text-center">Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200">
              <% farmers.forEach((f, idx) => { %>
              <tr class="hover:bg-slate-50/50">
                <td class="py-2 px-3 border border-slate-200 text-center font-mono text-[10px]"><%= idx + 1 %></td>
                <td class="py-2 px-3 border border-slate-200 font-mono font-bold text-[10px]"><%= f.nomor_kartu %></td>
                <td class="py-2 px-3 border border-slate-200 font-mono text-[10px]"><%= f.nik %></td>
                <td class="py-2 px-3 border border-slate-200 font-bold"><%= f.nama_lengkap %></td>
                <td class="py-2 px-3 border border-slate-200 text-[11px]"><%= f.distrik %>, <%= f.kampung %></td>
                <td class="py-2 px-3 border border-slate-200 text-[11px]"><%= f.nama_kelompok || '-' %></td>
                <td class="py-2 px-3 border border-slate-200 font-semibold"><%= f.komoditas_utama %></td>
                <td class="py-2 px-3 border border-slate-200 text-center uppercase font-bold text-[9px]">
                  <%= f.status_verifikasi %>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <!-- Official Signatures for Printed Document -->
        <div class="mt-12 pt-8 flex justify-between items-start text-xs text-slate-800 break-inside-avoid">
          <div class="text-center w-64">
            <p>Mengetahui,</p>
            <p class="font-bold">Kepala Bidang Sarana & Prasarana</p>
            <div class="h-20"></div>
            <p class="font-bold underline">HERMANUS RUMBRAWER, S.P.</p>
            <p class="text-[10px] text-slate-500">NIP. 19780512 200501 1 009</p>
          </div>

          <div class="text-center w-64">
            <p>Biak, <%= new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %></p>
            <p class="font-bold">Plt. Kepala Dinas Pertanian & Ketahanan Pangan</p>
            <div class="h-20 flex items-center justify-center text-xs font-mono text-emerald-800 italic">
              [ Ditandatangani secara Elektronik ]
            </div>
            <p class="font-bold underline">drh. BAMBANG HAYANTO</p>
            <p class="text-[10px] text-slate-500">NIP. 19720315 199803 1 006</p>
          </div>
        </div>

      </div>

    </div>
  </main>
</div>

<%- include('../partials/footer') %>
