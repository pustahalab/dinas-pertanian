<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="flex-1 flex overflow-hidden">
  <%- include('../partials/sidebar') %>

  <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 bg-slate-50/50">
    <div class="max-w-7xl mx-auto space-y-6">
      
      <!-- Toolbar -->
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 no-print">
        <div>
          <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Laporan Realisasi Bantuan Otsus</h1>
          <p class="text-xs text-slate-500 mt-1">Daftar kronologis penyaluran bantuan pertanian kepada masyarakat Orang Asli Papua (OAP).</p>
        </div>
        <div class="flex items-center space-x-3">
          <a href="/reports/aids?export=csv" class="px-4 py-2 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-bold text-xs transition flex items-center space-x-1.5 shadow-sm">
            <i class="bi bi-file-earmark-spreadsheet text-purple-600"></i>
            <span>Unduh CSV</span>
          </a>
          <button onclick="window.print()" class="px-4 py-2 rounded-xl bg-brand-700 hover:bg-brand-600 text-white font-bold text-xs transition flex items-center space-x-1.5 shadow-sm">
            <i class="bi bi-printer-fill"></i>
            <span>Cetak Laporan</span>
          </button>
        </div>
      </div>

      <!-- Report Paper -->
      <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6 sm:p-10 print:shadow-none print:border-none print:p-0">
        
        <div class="border-b-4 border-double border-slate-800 pb-4 mb-6 text-center">
          <h2 class="text-xs font-bold tracking-widest text-slate-800 uppercase">PEMERINTAH KABUPATEN BIAK NUMFOR</h2>
          <h1 class="text-lg font-extrabold text-slate-900 uppercase tracking-tight mt-1">LAPORAN KRONOLOGIS PENYALURAN BANTUAN OTONOMI KHUSUS PAPUA</h1>
          <p class="text-xs text-slate-600">Dinas Pertanian dan Ketahanan Pangan Kabupaten Biak Numfor Tahun Anggaran 2026</p>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs border-collapse">
            <thead>
              <tr class="border-y-2 border-slate-800 bg-slate-50 text-[10px] uppercase font-bold text-slate-700">
                <th class="py-2.5 px-3 border border-slate-300 w-10 text-center">No</th>
                <th class="py-2.5 px-3 border border-slate-300">Program Otsus</th>
                <th class="py-2.5 px-3 border border-slate-300">Penerima Manfaat</th>
                <th class="py-2.5 px-3 border border-slate-300">Wilayah</th>
                <th class="py-2.5 px-3 border border-slate-300">Volume & Jenis Bantuan</th>
                <th class="py-2.5 px-3 border border-slate-300 text-right">Nilai (Rp)</th>
                <th class="py-2.5 px-3 border border-slate-300">Tanggal</th>
                <th class="py-2.5 px-3 border border-slate-300 text-center">Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200">
              <% disbursements.forEach((d, idx) => { %>
              <tr class="hover:bg-slate-50/50">
                <td class="py-2 px-3 border border-slate-200 text-center font-mono text-[10px]"><%= idx + 1 %></td>
                <td class="py-2 px-3 border border-slate-200 font-semibold text-slate-800"><%= d.nama_program %></td>
                <td class="py-2 px-3 border border-slate-200">
                  <div class="font-bold"><%= d.nama_petani %></div>
                  <div class="font-mono text-[10px] text-slate-400"><%= d.nomor_kartu %></div>
                </td>
                <td class="py-2 px-3 border border-slate-200 text-[11px]"><%= d.kampung %>, <%= d.distrik %></td>
                <td class="py-2 px-3 border border-slate-200 font-bold text-brand-800"><%= d.volume_bantuan %></td>
                <td class="py-2 px-3 border border-slate-200 text-right font-mono text-amber-700 font-bold">
                  Rp <%= parseFloat(d.nilai_perkiraan).toLocaleString('id-ID') %>
                </td>
                <td class="py-2 px-3 border border-slate-200 text-[10px]"><%= d.tanggal_penyaluran %></td>
                <td class="py-2 px-3 border border-slate-200 text-center uppercase font-bold text-[9px] text-emerald-800">
                  <%= d.status_realisasi %>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <div class="mt-12 pt-8 flex justify-between items-start text-xs text-slate-800 break-inside-avoid">
          <div class="text-center w-64">
            <p>Pengelola Program Bantuan</p>
            <div class="h-20"></div>
            <p class="font-bold underline">PETUGAS PPL LAPANGAN</p>
          </div>
          <div class="text-center w-64">
            <p>Biak, <%= new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %></p>
            <p class="font-bold">Plt. Kepala Dinas Pertanian & Ketahanan Pangan</p>
            <div class="h-20"></div>
            <p class="font-bold underline">drh. BAMBANG HAYANTO</p>
          </div>
        </div>

      </div>

    </div>
  </main>
</div>

<%- include('../partials/footer') %>
