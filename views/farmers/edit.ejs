<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="flex-1 flex overflow-hidden">
  <%- include('../partials/sidebar') %>

  <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 bg-slate-50/50">
    <div class="max-w-4xl mx-auto space-y-6">
      
      <div class="flex items-center justify-between">
        <a href="/farmers/<%= farmer.id %>" class="text-xs font-bold text-slate-500 hover:text-brand-800 transition flex items-center space-x-1">
          <i class="bi bi-arrow-left"></i>
          <span>Kembali ke Detail Petani</span>
        </a>
      </div>

      <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6 sm:p-8">
        <div class="border-b border-slate-100 pb-5 mb-6">
          <h1 class="text-xl font-extrabold text-slate-900">Ubah Data Petani: <%= farmer.nama_lengkap %></h1>
          <p class="text-xs text-slate-500 mt-1">Nomor Kartu: <strong class="font-mono text-slate-800"><%= farmer.nomor_kartu %></strong></p>
        </div>

        <form action="/farmers/<%= farmer.id %>/edit" method="POST" class="space-y-6 text-xs">
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block font-bold text-slate-700 mb-1">Nama Lengkap</label>
              <input type="text" name="nama_lengkap" value="<%= farmer.nama_lengkap %>" required
                class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-brand-500">
            </div>

            <div>
              <label class="block font-bold text-slate-700 mb-1">NIK</label>
              <input type="text" name="nik" value="<%= farmer.nik %>" required
                class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-brand-500 font-mono">
            </div>

            <div>
              <label class="block font-bold text-slate-700 mb-1">Distrik</label>
              <select name="distrik" class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-brand-500">
                <% districts.forEach(d => { %>
                  <option value="<%= d.nama_distrik %>" <%= farmer.distrik === d.nama_distrik ? 'selected' : '' %>>
                    <%= d.nama_distrik %>
                  </option>
                <% }) %>
              </select>
            </div>

            <div>
              <label class="block font-bold text-slate-700 mb-1">Kampung</label>
              <input type="text" name="kampung" value="<%= farmer.kampung %>" required
                class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-brand-500">
            </div>

            <div>
              <label class="block font-bold text-slate-700 mb-1">Nomor Telepon</label>
              <input type="text" name="no_hp" value="<%= farmer.no_hp || '' %>"
                class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-brand-500">
            </div>

            <div>
              <label class="block font-bold text-slate-700 mb-1">Kelompok Tani</label>
              <select name="kelompok_tani_id" class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-brand-500">
                <option value="">-- Tanpa Kelompok Tani --</option>
                <% groups.forEach(g => { %>
                  <option value="<%= g.id %>" <%= farmer.kelompok_tani_id === g.id ? 'selected' : '' %>>
                    <%= g.nama_kelompok %> (<%= g.distrik %>)
                  </option>
                <% }) %>
              </select>
            </div>

            <div>
              <label class="block font-bold text-slate-700 mb-1">Komoditas Utama</label>
              <input type="text" name="komoditas_utama" value="<%= farmer.komoditas_utama %>" required
                class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-brand-500">
            </div>

            <div>
              <label class="block font-bold text-slate-700 mb-1">Luas Lahan (Ha)</label>
              <input type="number" step="0.05" name="luas_lahan" value="<%= farmer.luas_lahan %>"
                class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-brand-500">
            </div>

            <div class="sm:col-span-2">
              <label class="block font-bold text-slate-700 mb-1">Perkiraan Panen (Kg)</label>
              <input type="number" step="10" name="estimasi_panen_kg" value="<%= farmer.estimasi_panen_kg %>"
                class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-brand-500">
            </div>

            <div class="sm:col-span-2">
              <label class="block font-bold text-slate-700 mb-1">Alamat Lengkap</label>
              <textarea name="alamat" rows="2" class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-brand-500"><%= farmer.alamat || '' %></textarea>
            </div>
          </div>

          <div class="pt-4 border-t border-slate-100 flex items-center justify-end space-x-3">
            <a href="/farmers/<%= farmer.id %>" class="px-5 py-2.5 rounded-xl border border-slate-200 text-slate-600 font-bold hover:bg-slate-50 transition">
              Batal
            </a>
            <button type="submit" class="px-6 py-2.5 rounded-xl bg-brand-700 hover:bg-brand-600 text-white font-bold transition shadow-md shadow-brand-700/20">
              Simpan Perubahan
            </button>
          </div>

        </form>
      </div>

    </div>
  </main>
</div>

<%- include('../partials/footer') %>
