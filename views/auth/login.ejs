<%- include('../partials/header') %>

<div class="min-h-screen bg-gradient-to-br from-brand-950 via-brand-900 to-slate-900 flex flex-col justify-center py-12 sm:px-6 lg:px-8 relative overflow-hidden">
  
  <!-- Background Decorative Circles -->
  <div class="absolute -top-32 -left-32 w-96 h-96 rounded-full bg-emerald-500/10 blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-32 -right-32 w-96 h-96 rounded-full bg-amber-500/10 blur-3xl pointer-events-none"></div>

  <div class="sm:mx-auto sm:w-full sm:max-w-md text-center z-10 px-4">
    <!-- Emblem Icon -->
    <div class="inline-flex items-center justify-center w-20 h-20 rounded-3xl bg-gradient-to-tr from-emerald-500 to-emerald-300 text-brand-950 shadow-2xl shadow-emerald-500/20 mb-4 transform hover:rotate-3 transition duration-300">
      <i class="bi bi-shield-fill-check text-4xl"></i>
    </div>
    <h1 class="text-3xl font-extrabold text-white tracking-tight">SIM-KARTANI</h1>
    <p class="text-emerald-300 font-semibold text-sm mt-1">Sistem Informasi Kartu Tani OAP & Layanan Transportasi DAMRI</p>
    <p class="text-xs text-slate-400 mt-1">Dinas Pertanian dan Ketahanan Pangan Kabupaten Biak Numfor</p>
  </div>

  <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md z-10 px-4">
    <div class="bg-white/95 backdrop-blur-md py-8 px-6 sm:px-10 shadow-2xl rounded-3xl border border-white/20">
      
      <!-- Flash Alert -->
      <% if (flashError) { %>
      <div class="mb-5 p-3.5 rounded-xl bg-red-50 border border-red-200 text-red-700 text-xs flex items-center space-x-2">
        <i class="bi bi-exclamation-octagon-fill text-red-500 text-base"></i>
        <span><%= flashError %></span>
      </div>
      <% } %>

      <% if (flashSuccess) { %>
      <div class="mb-5 p-3.5 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs flex items-center space-x-2">
        <i class="bi bi-check-circle-fill text-emerald-600 text-base"></i>
        <span><%= flashSuccess %></span>
      </div>
      <% } %>

      <form action="/login" method="POST" class="space-y-5">
        <div>
          <label for="username" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">Nama Pengguna (Username)</label>
          <div class="relative rounded-xl shadow-sm">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
              <i class="bi bi-person-fill text-base"></i>
            </div>
            <input type="text" id="username" name="username" required
              class="block w-full pl-10 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition"
              placeholder="Contoh: admin / petugas / pimpinan">
          </div>
        </div>

        <div>
          <label for="password" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">Kata Sandi (Password)</label>
          <div class="relative rounded-xl shadow-sm">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
              <i class="bi bi-lock-fill text-base"></i>
            </div>
            <input type="password" id="password" name="password" required
              class="block w-full pl-10 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition"
              placeholder="Masukkan kata sandi">
          </div>
        </div>

        <button type="submit"
          class="w-full flex justify-center items-center space-x-2 py-3 px-4 border border-transparent rounded-xl shadow-lg shadow-emerald-700/20 text-sm font-bold text-white bg-gradient-to-r from-brand-700 to-brand-600 hover:from-brand-600 hover:to-brand-500 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-500 transition duration-200">
          <span>Masuk ke Dashboard</span>
          <i class="bi bi-arrow-right"></i>
        </button>
      </form>

      <!-- Divider -->
      <div class="relative my-6">
        <div class="absolute inset-0 flex items-center">
          <div class="w-full border-t border-slate-200"></div>
        </div>
        <div class="relative flex justify-center text-xs">
          <span class="px-3 bg-white text-slate-400 font-semibold uppercase tracking-wider">Akses Cepat Pengujian (Demo)</span>
        </div>
      </div>

      <!-- Quick Demo Login Buttons -->
      <div class="space-y-2">
        <p class="text-xs text-slate-500 text-center mb-2">Pilih peran di bawah ini untuk langsung masuk tanpa mengetik kata sandi:</p>
        <div class="grid grid-cols-2 gap-2 text-xs">
          <a href="/quick-login/admin" class="flex items-center space-x-2 p-2.5 rounded-xl border border-slate-200 hover:border-emerald-500 hover:bg-emerald-50/70 text-slate-700 font-bold transition">
            <div class="w-7 h-7 rounded-lg bg-emerald-100 text-emerald-800 flex items-center justify-center text-sm font-bold">A</div>
            <div>
              <div>Admin Dinas</div>
              <div class="text-[10px] text-slate-400 font-normal">Kelola Data & Hak</div>
            </div>
          </a>

          <a href="/quick-login/petugas" class="flex items-center space-x-2 p-2.5 rounded-xl border border-slate-200 hover:border-emerald-500 hover:bg-emerald-50/70 text-slate-700 font-bold transition">
            <div class="w-7 h-7 rounded-lg bg-blue-100 text-blue-800 flex items-center justify-center text-sm font-bold">P</div>
            <div>
              <div>Petugas PPL</div>
              <div class="text-[10px] text-slate-400 font-normal">Verifikasi Petani</div>
            </div>
          </a>

          <a href="/quick-login/pimpinan" class="flex items-center space-x-2 p-2.5 rounded-xl border border-slate-200 hover:border-emerald-500 hover:bg-emerald-50/70 text-slate-700 font-bold transition">
            <div class="w-7 h-7 rounded-lg bg-purple-100 text-purple-800 flex items-center justify-center text-sm font-bold">K</div>
            <div>
              <div>Kepala Dinas</div>
              <div class="text-[10px] text-slate-400 font-normal">Penetapan Bantuan</div>
            </div>
          </a>

          <a href="/quick-login/damri" class="flex items-center space-x-2 p-2.5 rounded-xl border border-slate-200 hover:border-amber-500 hover:bg-amber-50/70 text-slate-700 font-bold transition">
            <div class="w-7 h-7 rounded-lg bg-amber-100 text-amber-800 flex items-center justify-center text-sm font-bold">D</div>
            <div>
              <div>Petugas DAMRI</div>
              <div class="text-[10px] text-slate-400 font-normal">Scan QR & Angkutan</div>
            </div>
          </a>
        </div>

        <a href="/quick-login/petani" class="flex items-center justify-center space-x-2 p-2.5 w-full rounded-xl border border-emerald-300 bg-emerald-50 hover:bg-emerald-100 text-emerald-900 font-bold transition text-xs mt-2">
          <i class="bi bi-qr-code text-base text-emerald-700"></i>
          <span>Portal Petani OAP (Demo Kartu Digital & QR Code)</span>
        </a>
      </div>

    </div>

    <!-- Security & Institutional Note -->
    <div class="text-center mt-6 text-xs text-slate-400 space-y-1">
      <p>Program Bantuan Otonomi Khusus (Otsus) Papua Tahun 2026</p>
      <p>Sistem dilindungi otentikasi terenkripsi & pencatatan jejak audit (Audit Trail).</p>
    </div>

  </div>

</div>

<%- include('../partials/footer') %>
